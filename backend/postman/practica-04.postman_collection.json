                  "});",
                  "",
                  "pm.test('Mensaje de empleado no encontrado', function () {",
                  "  pm.expect(pm.response.json().message).to.eql('Empleado no encontrado');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar empleado",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cargo\": \"Arquitecto de Software Senior\",\n  \"sueldo\": 5200\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/empleados/{{empleadoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["empleados", "{{empleadoId}}"]
            },
            "description": "PUT /api/v1/empleados/:id\n\nValidación previa: `idParamSchema` sobre `:id` + `updateEmployeeSchema` (el mismo esquema de creación pero `.partial()`: puedes enviar solo los campos que cambian, como en este ejemplo).\n\nRespuesta verificada: **200** con el recurso actualizado."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Se actualizaron solo los campos enviados', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.cargo).to.eql('Arquitecto de Software Senior');",
                  "  pm.expect(body.data.sueldo).to.eql(5200);",
                  "  pm.expect(body.data.nombre).to.eql('Andrés Mendoza');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar empleado - no existe (404)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sueldo\": 6000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/empleados/000000000000000000000000",
              "host": ["{{baseUrl}}"],
              "path": ["empleados", "000000000000000000000000"]
            },
            "description": "Actualiza un id con formato válido pero inexistente.\n\nRespuesta verificada: **404 Not Found**."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 404 Not Found', function () {",
                  "  pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar empleado",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/empleados/{{empleadoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["empleados", "{{empleadoId}}"]
            },
            "description": "DELETE /api/v1/empleados/:id\n\nRespuesta verificada: **204 No Content**, sin cuerpo (por RFC 9110 un 204 no lleva body — es la única respuesta fuera del Response Wrapper)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 204 No Content', function () {",
                  "  pm.response.to.have.status(204);",
                  "});",
                  "",
                  "pm.test('El cuerpo va vacío', function () {",
                  "  pm.expect(pm.response.text()).to.have.lengthOf(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar empleado - ya no existe (404)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/empleados/{{empleadoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["empleados", "{{empleadoId}}"]
            },
            "description": "Repite el DELETE sobre el mismo `empleadoId`, ya eliminado por el request anterior.\n\nRespuesta verificada: **404 Not Found** con el Response Wrapper."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 404 Not Found', function () {",
                  "  pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test('Mensaje de empleado no encontrado', function () {",
