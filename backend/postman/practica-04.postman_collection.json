                  "",
                  "pm.test('Error de formato en el campo id', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.errors[0].field).to.eql('id');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener empleado - no existe (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/empleados/000000000000000000000000",
              "host": ["{{baseUrl}}"],
              "path": ["empleados", "000000000000000000000000"]
