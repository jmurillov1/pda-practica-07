            "description": "Id con formato de ObjectId válido pero que no existe en la colección.\n\nRespuesta verificada: **404 Not Found** con el Response Wrapper (`success:false`)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 404 Not Found', function () {",
